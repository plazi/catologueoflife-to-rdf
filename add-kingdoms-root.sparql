PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>

INSERT {
  ?taxon dwc:kingdom ?kingdom .
} WHERE {
  ?taxon dwc:taxonRank "kingdom" ;
         dwc:scientificName ?full_name .
  OPTIONAL { ?taxon dwc:scientificNameAuthorship ?authority . }
  # Some kingdoms have an authority, which has to be trimmed. It is removed as a plain
  # suffix: authorities such as "(Garrity & Holt, 2023) Oren & Göker 2024" contain
  # regex metacharacters, so they cannot be used as a REPLACE pattern.
  BIND(IF(BOUND(?authority) && STRENDS(?full_name, CONCAT(" ", ?authority)),
          SUBSTR(?full_name, 1, STRLEN(?full_name) - STRLEN(?authority) - 1),
          ?full_name) AS ?kingdom)
};
